datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PILOT
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String
  name                String?
  role                Role           @default(PILOT)
  isActive            Boolean        @default(true)
  lastLoginAt         DateTime?
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  refreshTokens       RefreshToken[]

  // NAYA RELATION: Ek Pilot multiple forms fill kar sakta hai
  pilotForms          PilotForm[]

  // Signature & Countersign fields
  signatureImage      String?        @db.Text
  countersignedForms  PilotForm[]    @relation("CountersignedForms")

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@map("refresh_tokens")
}

enum FormStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum ActivityType {
  ARRIVAL
  DEPARTURE
  SHIFTING
  SWINGING
  CANCELLATION
}

enum VesselType {
  LNGC
  LPG
  TANKER
  CONTAINER
  BULK_CARRIER
  OTHERS
}

enum CraftType {
  PILOT_BOAT
  TUG
  MOORING_BOAT
  ESCORTING_TUG
}


model PilotForm {
  id                      String        @id @default(cuid())
  serialNo                String        @unique // e.g., "55201"
  pilotId                 String
  pilot                   User          @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  status                  FormStatus    @default(DRAFT)
  
  // 1. General Info
  activityType            ActivityType
  activityDateTime        DateTime
  cancellationDateTime    DateTime?
  
  // 2. Vessel Details
  vesselType              VesselType
  vesselName              String
  registrationNo          String
  pcNo                    String?       // P/C
  localAgency             String
  
  // 3. Pilotage & Berthing (Dates & Times)
  boardingDate            DateTime
  disembarkationDate      DateTime
  berthSide               String?
  unmooredDate            DateTime?
  unmooredPlace           String?
  mooredDate              DateTime?
  mooredPlace             String?
  
  // 4. Extra Pilotage & Dispensation
  isExtraPilotageNight    Boolean       @default(false)
  isExtraPilotageHoliday  Boolean       @default(false)
  dispensation            String?
  
  // 5. Vessel Dimensions (in meters)
  loa                     Float
  beam                    Float
  gt                      Float
  nt                      Float
  dwt                     Float
  draftFwd                Float
  draftAft                Float
  
  // 6. Cargo Details (in MTS)
  cargoPQ                 Float
  deckCargo               Float
  dgCargo                 Float
  totalCargo              Float
  
  // 7. Safety Declarations
  abnormalTempRiseDG      Boolean       @default(false)
  leakageLiquidDG         Boolean       @default(false)
  stowagePlanDGAttached   Boolean       @default(false)
  
  // 8. Relations & Metadata
  craftsUsed              CraftUsage[]  // 1-to-Many normalized relation
  additionalRemarks       String?       @db.Text

  // 9. Declaration & Pilot Signature
  isDeclared              Boolean       @default(false)
  pilotSignedAt           DateTime?
  pilotSignatureIp        String?

  // 10. Master Signature
  isMasterSigned          Boolean       @default(false)
  masterSignature         String?       @db.Text   // Base64 image or URL
  masterSignedAt          DateTime?
  masterName              String?
  shipStampImage          String?       @db.Text   // Base64 image or URL

  // 11. HM / DM Countersign
  hmDmUserId              String?
  hmDmUser                User?         @relation("CountersignedForms", fields: [hmDmUserId], references: [id])
  hmDmSignature           String?       @db.Text
  hmDmSignedAt            DateTime?

  // 12. Rejection
  rejectionReason         String?       @db.Text

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([pilotId])
  @@index([hmDmUserId])
  @@map("pilot_forms")
}

// Normalized Table for Crafts Used (Grid on the form)
model CraftUsage {
  id              String      @id @default(cuid())
  formId          String
  pilotForm       PilotForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  
  craftType       CraftType
  craftName       String      // e.g., "Tug 1", "Mooring Boat 2"
  fromLocation    String
  toLocation      String
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([formId])
  @@map("craft_usages")
}