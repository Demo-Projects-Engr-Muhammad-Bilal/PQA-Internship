# ============================================================
# Database — Supabase Connection Strings
# ============================================================

# Transaction Pooler — used by the application at runtime (Vercel serverless)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String → Transaction (port 6543)
# The pgbouncer=true and connection_limit=1 params are REQUIRED for serverless deployments
# to avoid exhausting Supabase's connection limit under concurrent load.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct Connection — used ONLY by Prisma migrate (bypasses pgbouncer)
# Get this from: Supabase Dashboard → Project Settings → Database → Connection String → Direct (port 5432)
# Do NOT use this as DATABASE_URL — it bypasses the pooler and will exhaust connections.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"

# ============================================================
# Authentication (JWT)
# ============================================================
# Note: must be >= 32 chars for secure hashing
JWT_ACCESS_SECRET="your_super_secret_access_token_key_here_32+"
JWT_REFRESH_SECRET="your_super_secret_refresh_token_key_here_32+"

# ============================================================
# Security & Ops (Field Level Encryption)
# ============================================================
# Note: run `openssl rand -base64 32` to generate this key
FIELD_ENCRYPTION_KEY="<openssl rand -base64 32>"
